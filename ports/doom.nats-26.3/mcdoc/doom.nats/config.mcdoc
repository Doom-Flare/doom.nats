// doom.nats —— 作者/地图可改面的类型声明（Spyglass mcdoc）
// 用途：给编辑器提供类型与中文文档提示；也是后续"绑定 storage 校验"的地基。
// 注意：这里只声明**我们自己的**存储形状；原版数据遵循 Spyglass 自带的 minecraft mcdoc。
//
// 写入位置（作者侧）：
//   /data merge storage doom.nats:config { <字段>: <值>, ... }   // 只写要改的键
//   /function doom.nats:cfg/apply                                // 折算成 $cfg.* 计分板
// 默认值由 doom.nats:cfg/setup 每次装载重写（= 原版语义）。

/// 单个维度的整数表（键为维度 id）
struct PerDimension {
	overworld?: int,
	the_nether?: int,
	the_end?: int,
}

/// 高度带取点模式
enum(0..3) BandMode {
	/// 自动找地面
	AUTO = 0,
	/// 固定带随机
	FIXED = 1,
	/// 跟随玩家 ± jitter
	FLEE = 2,
	/// 均匀随机带（最接近原版 uniform(minY, 地表+1)）
	UNIFORM = 3,
}

/// 取点高度带
struct Band {
	mode?: BandMode,
	yMin?: int,
	yMax?: int,
	jitter?: int,
}

/// 作者可改配置（doom.nats:config 覆盖 doom.nats:cfg_defaults）
struct Config {
	/// 水面窗口（seaLevel-13..seaLevel）、发光鱿鱼 y ≤ seaLevel-33、海龟 y < seaLevel+4
	seaLevel?: PerDimension,
	/// 怪物"暗"档上限（数据包按档位近似采样 uniform(0..light)）
	light?: PerDimension,
	/// mobcap：maxInstancesPerChunk（原版 MobCategory 构造参数）
	cap?: {
		monster?: int,
		creature?: int,
		ambient?: int,
		water_creature?: int,
		water_ambient?: int,
		underground_water_creature?: int,
		axolotls?: int,
	},
	/// 消失距离（原版 MobCategory 第 5 个构造参数）
	distance?: {
		monster?: int,
		creature?: int,
		ambient?: int,
		water_creature?: int,
		water_ambient?: int,
		underground_water_creature?: int,
		axolotls?: int,
	},
	/// MobCategory.noDespawnDistance：近于此距离会清零 noActionTime
	noDespawnDistance?: int,
	/// NaturalSpawner.isRightDistanceToPlayerAndSpawnPoint：distSq ≤ 24² 拒
	playerExclusion?: int,
	/// 世界出生点 24 格排除（v4.17 / P1-5）：0 = 关闭（默认）
	/// 原版 isRightDistanceToPlayerAndSpawnPoint 的第二个分支：getSharedSpawnPos().closerToCenterThan(pos,24) 拒
	/// 数据包读不到出生点 ⇒ 必须由作者声明坐标；缺任一轴自动视为关闭（见 docs/18 §2.2b）
	spawn24?: int,
	/// 世界出生点的方块 X 坐标（整数）；spawn24:1 且三轴齐全才生效
	spawnX?: int,
	/// 世界出生点的方块 Y 坐标（整数）；判定含 BlockPos 中心的 +0.5 半格偏移，正好 24 格不算拒
	spawnY?: int,
	/// 世界出生点的方块 Z 坐标（整数）；该判定失败归因 reason=10
	spawnZ?: int,
	/// 每 period tick 发起一批刷怪尝试
	period?: int,
	/// 每批多少个原点（吞吐旋钮）
	batch?: int,
	/// 密度控制（AIMD）的上限
	maxBatch?: int,
	/// 目标生成数/分钟（0 = 关闭自动调节，用 batch 手工值）
	density?: int,
	/// 本包自带的概率消失层；0 = 关闭，交给原版 Mob.checkDespawn
	dice?: int,
	/// 被动生物（creature）只在 gameTime % creatureGate == 0 那一拍进候选
	creatureGate?: int,
	/// 1 ⇒ 本包生成物都带 PersistenceRequired:1b
	persist?: int,
	/// 1 ⇒ monster 类别整类不进候选（原版 peacefeee 难度语义）
	peaceful?: int,
	/// 0 和平 / 1 简单 / 2 普通 / 3 困难（数据包读不到游戏难度）
	difficulty?: int,
	/// 区域难度系数 percent；-1 = 按 difficulty 自动
	special?: int,
	/// 刷怪数量总开关（百分比）：100 = 原样，50 = 各类上限减半，200 = 翻倍；有效范围 1..1000
	/// 只缩【容量上限】（maxInstancesPerChunk），不动节拍（速度另有 density / batch / period）
	/// 一键档位：/function doom.nats:scale/{sparse,normal,dense,horde,extreme}
	qty?: int,
	/// 取点高度带
	band?: Band,
}
